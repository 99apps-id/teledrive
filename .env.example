NODE_ENV=development
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./teledrive.db
REDIS_URL=redis://localhost:6381/0
STORAGE_TEMP_PATH=./storage

# Required in production. Generate two distinct values with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENCRYPTION_KEY=
# Production default before the first operator setting is false. Set true only
# long enough to create the first trusted operator account, then use Account
# settings in the web app to disable registration.
TELEDRIVE_REGISTRATION_ENABLED=false

# Optional server-level fallback. For open-source/user installs, prefer the
# in-app Telegram setup wizard so each user stores encrypted credentials.
# Telegram user-account storage, not bot storage.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEDRIVE_STORAGE_CHANNEL=TeleDrive Storage

# Server Files:
# Use "local" when TeleDrive is installed on the VPS and should read the VPS
# filesystem directly. Use "sftp" when TeleDrive runs on a local computer and
# should access the VPS over SSH/SFTP.
TELEDRIVE_SERVER_FILES_MODE=local
TELEDRIVE_SERVER_FILES_ROOT=./server-files
TELEDRIVE_SERVER_FILES_SFTP_HOST=example.com
TELEDRIVE_SERVER_FILES_SFTP_PORT=22
TELEDRIVE_SERVER_FILES_SFTP_USER=deploy
TELEDRIVE_SERVER_FILES_SFTP_PASSWORD=
TELEDRIVE_SERVER_FILES_SFTP_KEY_PATH=
TELEDRIVE_SERVER_FILES_SFTP_ROOT=/home/deploy
# Development-only escape hatch. Production should use SSH known_hosts.
TELEDRIVE_SERVER_FILES_SFTP_ALLOW_UNKNOWN_HOSTS=false

# Update checker. Override this for forks or disable it for private networks.
TELEDRIVE_UPDATE_CHECK_ENABLED=true
TELEDRIVE_RELEASES_API_URL=https://api.github.com/repos/99apps-id/teledrive/releases/latest

# Production Docker settings. docker-compose.production.yml refuses to start
# until every required value is set. Use a unique password for each service.
# FRONTEND_URL=https://drive.example.com
# API_URL=https://drive.example.com/api
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
